#!/bin/sh
# D-0010: block commits whose staged content matches a secret rule.
# Install once per clone:  git config core.hooksPath scripts/hooks
root="$(git rev-parse --show-toplevel)"
python="$root/.venv/bin/python"
if [ ! -x "$python" ]; then
  echo "pre-commit: $python not found; create the venv (see CURRENT.md) before committing." >&2
  exit 1
fi
"$python" "$root/scripts/scan_staged_secrets.py" || exit 1
# D-0011 amendment 8: when detector code, rules or the corpus change, the holdout measurement must pass.
if git diff --cached --name-only | grep -Eq '^(src/nacre/ledger/strip_secrets\.py|src/nacre/ledger/data/|tests/ledger/secret_corpus/|tests/ledger/test_strip_secrets\.py|tests/ledger/test_secret_corpus\.py)'; then
  echo "pre-commit: detector/rules/corpus changed; running holdout measurement (pytest -m holdout)..." >&2
  (cd "$root" && "$python" -m pytest -q -m holdout -p no:cacheprovider) || { echo "pre-commit: holdout measurement failed" >&2; exit 1; }
fi
