    {
      "id": "atlasparser-qn",
      "entities": [
        "system:atlasparser",
        "format:qn-boolean"
      ],
      "experience": {
        "prompt": "AtlasParser receives a legacy record with enabled=Q. The normal JSON schema rejects it. What should happen before schema validation?",
        "feedback": "AtlasParser compatibility rule: normalize legacy Q/N booleans before schema validation. Q becomes true and N becomes false, then run the normal schema validator.",
        "grader": {
          "all_of": [
            [
              "q becomes true",
              "q to true",
              "q as true"
            ],
            [
              "before schema validation",
              "before validation",
              "then validate"
            ]
          ],
          "none_of": [
            "reject q",
            "drop the field"
          ]
        }
      },
      "transfer": {
        "prompt": "AtlasParser receives a legacy record with archived=N. The normal JSON schema rejects it. What should happen before schema validation?",
        "grader": {
          "all_of": [
            [
              "n becomes false",
              "n to false",
              "n as false"
            ],
            [
              "before schema validation",
              "before validation",
              "then validate"
            ]
          ],
          "none_of": [
            "reject n",
            "drop the field"
          ]
        }
      }
    },
