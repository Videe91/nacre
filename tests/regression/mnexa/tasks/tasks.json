        "system:orchiddb",
        "code:l42"
      ],
      "experience": {
        "prompt": "OrchidDB returns L42 during an inventory reservation transaction. What should the operator do?",
        "feedback": "OrchidDB runbook rule: L42 means the lease token is stale. Refresh the lease token, retry the transaction exactly once, and do not reconnect the database session.",
        "grader": {
          "all_of": [
            [
              "refresh the lease token",
              "refresh lease token"
            ],
            [
              "retry the transaction exactly once",
              "retry exactly once",
              "retry once"
            ],
            [
              "do not reconnect",
              "without reconnecting"
            ]
          ],
          "none_of": [
            "restart the database",
            "retry indefinitely"
          ]
        }
      },
      "transfer": {
