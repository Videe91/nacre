{
  "experiment": "seed-growth-001",
  "note": "Exploratory synthetic transfer tasks. These are not a confirmatory benchmark.",
  "families": [
    {
      "id": "nebulapay-r17",
      "entities": [
        "system:nebulapay",
        "code:r17"
      ],
      "experience": {
        "prompt": "NebulaPay returns R17 while capturing an invoice payment. What should the operator do?",
        "feedback": "NebulaPay runbook rule: for R17, wait 3 seconds, retry exactly once, and include the header X-Nebula-Replay: safe on the retry.",
        "grader": {
          "all_of": [
            ["3 seconds", "3s"],
            ["retry exactly once", "retry once"],
            ["x-nebula-replay"]
          ],
          "none_of": [
            "exponential backoff",
            "retry indefinitely"
          ]
        }
      },
      "transfer": {
        "prompt": "NebulaPay returns R17 while creating a refund. What should the operator do?",
        "grader": {
          "all_of": [
            ["3 seconds", "3s"],
            ["retry exactly once", "retry once"],
            ["x-nebula-replay"]
          ],
          "none_of": [
            "exponential backoff",
            "retry indefinitely"
          ]
        }
      }
    },
    {
